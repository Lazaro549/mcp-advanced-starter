# ========================
# Anthropic Claude API
# ========================

# Optional: omit this variable to use the deterministic mock sampling response.
# Get a key from: https://console.anthropic.com/settings/keys
# Never commit a real API key.
# ANTHROPIC_API_KEY=

# The interactive MCP client reads this exact variable.
MCP_SAMPLING_MODEL=claude-haiku-4-5-20251001

# Optional: override the base URL (useful for proxies and compatible providers).
# ANTHROPIC_BASE_URL=https://api.anthropic.com
